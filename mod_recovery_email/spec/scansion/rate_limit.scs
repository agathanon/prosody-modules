		</command>
	</iq>

Tybalt sends:
	<iq type="set" id="change4" to="localhost">
		<command xmlns="http://jabber.org/protocol/commands" node="recovery-email" action="execute">
			<x xmlns="jabber:x:data" type="submit">
				<field var="email"><value>tybalt4@example.org</value></field>
			</x>
